---
import type { Category, Product } from '@/types/types';
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";


const mockCategories: Category[] = [
  { id: 'cat-1', name_category: 'Готові FPV Дрони', code_category: 'drones', slug: 'drones', parent_id: null },
  { id: 'cat-2', name_category: 'Комплектуючі', code_category: 'components', slug: 'components', parent_id: null },
  { id: 'cat-3', name_category: 'Мотори', code_category: 'motors', slug: 'motors', parent_id: 'cat-2' },
  { id: 'cat-4', name_category: 'Рами', code_category: 'frames', slug: 'frames', parent_id: 'cat-2' },
];

const mockProducts: Product[] = [
  { id: 'p1', title: 'FPV Дрон Chimera7 Pro V2 6S 1W', price: 24500, sku: 'DR-CH7', category_id: 'cat-1', image: null },
  { id: 'p2', title: 'FPV Дрон Nazgul Evoke F5 V2', price: 18200, sku: 'DR-NZ5', category_id: 'cat-1', image: null },
  { id: 'p3', title: 'Мотор SPEEDX2 2809 1250KV', price: 1250, sku: 'MOT-SX2', category_id: 'cat-3', image: null },
  { id: 'p4', title: 'Мотор Xing2 2207 1855KV', price: 980, sku: 'MOT-X22', category_id: 'cat-3', image: null },
  { id: 'p5', title: 'Рама Mark5 DC Frame Kit', price: 3100, sku: 'FRM-MK5', category_id: 'cat-4', image: null },
];

const rootCategories = mockCategories.filter(c => c.parent_id === null);

function getSubcategories(parentId: string | number) {
  return mockCategories.filter(c => c.parent_id === parentId);
}

function getProductsForCategory(catId: string | number) {
  return mockProducts.filter(p => p.category_id === catId);
}
---

<Layout title="Каталог товарів | Fpv Master">
  <div class="container mx-auto max-w-7xl px-2 py-8">
    
    <!-- Шапка каталогу -->
    <header class="border-b border-neutral-300 pb-4 mb-8 flex justify-between items-end">
      <div>
        <h1 class="text-3xl font-bold uppercase tracking-tight text-neutral-900">Каталог товарів</h1>
        <p class="text-xs text-neutral-500 font-mono mt-1">Оновлено: {new Date().toLocaleDateString('uk-UA')}</p>
      </div>
      <div class="text-xs text-neutral-500 font-mono">
        Всього категорій: {mockCategories.length} | Товарів: {mockProducts.length}
      </div>
    </header>

    <!-- Перелік категорій -->
    <div class="space-y-12">
      {rootCategories.map((rootCat) => {
        const subCats = getSubcategories(rootCat.id);
        const directProducts = getProductsForCategory(rootCat.id);

        return (
          <section class="border border-neutral-200 bg-white rounded-lg p-6 shadow-sm">
            
            <div class="border-b border-neutral-200 pb-3 mb-6 flex justify-between items-center">
              <h2 class="text-xl font-bold text-neutral-900 tracking-tight">
                <a href={`/catalog/${rootCat.slug}`} class="hover:text-indigo-600 transition">
                  {rootCat.name_category}
                </a>
              </h2>
              <a href={`/catalog/${rootCat.slug}`} class="text-xs font-semibold uppercase text-neutral-500 hover:text-neutral-900">
                Переглянути розділ &rarr;
              </a>
            </div>

            <!-- Товари прямої категорії -->
            {directProducts.length > 0 && (
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                {directProducts.map((product) => (
                  <div class="border border-neutral-200 p-3 rounded flex flex-col justify-between hover:border-neutral-400 transition bg-neutral-50/50">
                    <div>
                      <!-- Бутафорна картинка / Плейсхолдер -->
                      <div class="w-full h-28 bg-neutral-100 rounded border border-neutral-200 mb-3 flex flex-col items-center justify-center text-neutral-400">
                        {product.image ? (
                          <img src={product.image} alt={product.title} class="w-full h-full object-cover rounded" />
                        ) : (
                          <>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 opacity-40 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="text-[9px] font-mono uppercase tracking-wider text-neutral-400">No photo</span>
                          </>
                        )}
                      </div>

                      <span class="text-[10px] font-mono text-neutral-400 block">{product.sku}</span>
                      <h3 class="text-xs font-semibold text-neutral-800 line-clamp-2 mt-1">{product.title}</h3>
                    </div>

                    <div class="mt-4 pt-2 border-t border-neutral-200 flex justify-between items-center">
                      <span class="text-sm font-bold text-neutral-900">{product.price} ₴</span>
                      <a href={`/product/${product.id}`} class="text-[11px] font-medium text-indigo-600 hover:underline">
                        Детальніше
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            )}

            <!-- Вкладені категорії (Parent ID) -->
            {subCats.length > 0 && (
              <div class="space-y-6 mt-4">
                {subCats.map((subCat) => {
                  const subProducts = getProductsForCategory(subCat.id);
                  return (
                    <div class="pl-4 border-l-2 border-neutral-200">
                      <h3 class="text-sm font-bold text-neutral-700 uppercase tracking-wider mb-3">
                        <a href={`/catalog/${subCat.slug}`} class="hover:text-indigo-600">
                          ↳ {subCat.name_category}
                        </a>
                      </h3>

                      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                        {subProducts.map((product) => (
                          <div class="border border-neutral-200 p-3 rounded flex flex-col justify-between hover:border-neutral-400 transition bg-white">
                            <div>
                              <!-- Бутафорна картинка / Плейсхолдер -->
                              <div class="w-full h-28 bg-neutral-100 rounded border border-neutral-200 mb-3 flex flex-col items-center justify-center text-neutral-400">
                                {product.image ? (
                                  <img src={product.image} alt={product.title} class="w-full h-full object-cover rounded" />
                                ) : (
                                  <>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 opacity-40 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                    <span class="text-[9px] font-mono uppercase tracking-wider text-neutral-400">No photo</span>
                                  </>
                                )}
                              </div>

                              <span class="text-[10px] font-mono text-neutral-400 block">{product.sku}</span>
                              <h4 class="text-xs font-semibold text-neutral-800 line-clamp-2 mt-1">{product.title}</h4>
                            </div>

                            <div class="mt-4 pt-2 border-t border-neutral-100 flex justify-between items-center">
                              <span class="text-sm font-bold text-neutral-900">{product.price} ₴</span>
                              <a href={`/product/${product.id}`} class="text-[11px] font-medium text-indigo-600 hover:underline">
                                Детальніше
                              </a>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

          </section>
        );
      })}
    </div>

  </div>
</Layout>