---
import { getCategoryTree } from "@/services/categories";
import { Navigation } from "./Navigation";
import { Search } from "./Search";
import { UserActions } from "./UserActions";
import { Image } from 'astro:assets';
import { BottomNav } from "../BottomNav/BottomNav";

const categories = await getCategoryTree();

const staticNav = [
  { name: 'Доставка та оплата', href: '/dostavka-i-oplata' },
  { name: 'Знижки', href: '/sales', badge: 'HOT' },
  { name: 'Повернення товару', href: '/return-policy' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200">
  <div class="container mx-auto max-w-7xl px-2 h-12 sm:h-14 flex items-center justify-between gap-2 sm:gap-1">
    
    <a 
      href="/" 
      class="flex items-center gap-1 text-neutral-900 hover:text-neutral-700 transition shrink-0 group"
    >
      <Image 
        src="/logo.png" 
        alt="FPV Master Logo" 
        width={32} 
        height={32} 
        class="w-8 h-8 shrink-0" 
      />

      <div class="h-7 w-[1px] bg-neutral-700 shrink-0 hidden sm:block"></div>

      <span class="font-logo text-2xl font-bold tracking-tight uppercase hidden sm:flex items-center gap-1">
        <span class="text-[#67BAF4]">FPV</span>
        <span class="text-black font-semibold">Master</span>
      </span>
    </a>
    
    <Navigation client:load categories={categories} staticNav={staticNav} />

    <div class="flex items-center justify-end w-full sm:w-auto flex-1 lg:flex-none min-w-0 gap-2">
      <Search client:only="react" />
      <div class="hidden lg:flex items-center">
        <UserActions client:load />
      </div>
    </div>

  </div>
</header>

<BottomNav categories={categories} staticNav={staticNav} client:only="react" />