---
import { getCategoryTree } from "@/services/categories";
import { Navigation } from "./Navigation";
import { Search } from "./Search";
import { UserActions } from "./UserActions";

const categories = await getCategoryTree();

const staticNav = [
  { name: 'Головна', href: '/' },
  { name: 'Акції', href: '/sales', badge: 'HOT' },
  { name: 'Про нас', href: '/about' },
  { name: 'Блог', href: '/blog' },
  { name: 'Контакти', href: '/contacts' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200 shadow-sm">
  <div class="container mx-auto max-w-7xl px-4 h-16 flex items-center justify-between gap-2">
    
    <a
      href="/"
      class="text-xl font-black tracking-tight text-neutral-900 hover:text-neutral-700 transition shrink-0"
    >
      MY<span class="text-neutral-500">STORE</span>
    </a>
    
    <Navigation client:load categories={categories} staticNav={staticNav} />

    <div class="flex items-center gap-3 shrink-0">
      <Search client:load />
      <UserActions client:load cartCount={0} />
    </div>

  </div>
</header>