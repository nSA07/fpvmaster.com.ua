---
import { getCategoryTree } from "@/services/categories";

const categories = await getCategoryTree();

const staticNav = [
  { name: 'Головна', href: '/' },
  { name: 'Акції', href: '/sales', badge: 'HOT' },
  { name: 'Про нас', href: '/about' },
  { name: 'Блог', href: '/blog' },
  { name: 'Контакти', href: '/contacts' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200 shadow-sm">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-6">
    
    <!-- 1. Логотип -->
    <a href="/" class="text-xl font-bold tracking-tight text-neutral-900 hover:text-neutral-700 transition shrink-0">
      MY<span class="text-indigo-600">STORE</span>
    </a>

    <!-- 2. Навігація по центру -->
    <nav class="hidden lg:flex items-center justify-center gap-2 flex-1">
      
      <!-- Дропдаун "Категорії" -->
      <div class="relative group/catalog">
        <button 
          type="button" 
          class="flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          Категорії
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-80 group-hover/catalog:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Фіксоване двоколоночне вікно (з'являється при наведенні на кнопку "Категорії") -->
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover/catalog:opacity-100 group-hover/catalog:translate-y-0 group-hover/catalog:pointer-events-auto transition-all duration-200 z-50">
          <div class="relative w-[750px] h-[400px] bg-white rounded-xl shadow-2xl border border-neutral-200/80 p-2 flex gap-0">
            
            <!-- ЛІВЕ ВІКНО: Список усіх категорій (ширина 250px зі своїм скролом) -->
            <div class="w-[250px] shrink-0 border-r border-neutral-100 pr-2 space-y-1 overflow-y-auto h-full">
              {categories.map((cat) => (
                <div class="group/item">
                  <a 
                    href={`/catalog/${cat.slug}`}
                    class="flex items-center justify-between px-3 py-2.5 text-sm font-medium text-neutral-700 hover:text-indigo-600 hover:bg-indigo-50/80 rounded-lg transition-colors"
                  >
                    <span class="truncate">{cat.name_category}</span>
                    {cat.children && cat.children.length > 0 && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-neutral-400 group-hover/item:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    )}
                  </a>

                  <!-- ПРАВЕ ВІКНО: Накладається поверх порожнього полотна ЛИШЕ при наведенні на конкретну категорію -->
                  {cat.children && cat.children.length > 0 && (
                    <div class="absolute right-0 top-0 w-[490px] h-full hidden group-hover/item:block p-4 overflow-y-auto bg-white rounded-r-xl z-10">
                      <div class="text-xs font-bold text-neutral-400 uppercase tracking-wider mb-3 pb-2 border-b border-neutral-100">
                        {cat.name_category}
                      </div>

                      <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                        {cat.children.map((subCat) => (
                          <div class="space-y-1.5">
                            <!-- Підкатегорія (2-й рівень) -->
                            <a 
                              href={`/catalog/${subCat.slug}`}
                              class="text-sm font-bold text-neutral-800 hover:text-indigo-600 block transition-colors leading-tight"
                            >
                              {subCat.name_category}
                            </a>
                            
                            <!-- Підкатегорія (3-й рівень) -->
                            {subCat.children && subCat.children.length > 0 && (
                              <div class="space-y-1 pl-0.5">
                                {subCat.children.map((subSubCat) => (
                                  <a 
                                    href={`/catalog/${subSubCat.slug}`}
                                    class="text-xs text-neutral-500 hover:text-indigo-600 block transition-colors truncate"
                                  >
                                    {subSubCat.name_category}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>

            <!-- ПРАВЕ ВІКНО ЗА ЗАМОВЧУВАННЯМ (Порожнє полотно, поки миша не наведена на категорію) -->
            <div class="flex-1 h-full bg-white rounded-r-xl flex items-center justify-center p-6 text-center">
              <span class="text-xs text-neutral-400 font-medium">
                Оберіть категорію зі списку ліворуч
              </span>
            </div>

          </div>
        </div>
      </div>

      <!-- Статичні посилання -->
      <div class="flex items-center gap-1 ml-2">
        {staticNav.map((item) => (
          <a 
            href={item.href}
            class="relative px-3.5 py-2 text-sm font-medium text-neutral-600 hover:text-indigo-600 hover:bg-neutral-50 rounded-lg transition-colors flex items-center gap-1.5"
          >
            {item.name}
            {item.badge && (
              <span class="bg-rose-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full uppercase tracking-wider">
                {item.badge}
              </span>
            )}
          </a>
        ))}
      </div>

    </nav>

    <!-- 3. Пошук та кошик -->
    <div class="flex items-center gap-4 shrink-0">
      <div class="relative hidden sm:block w-44 lg:w-56">
        <input 
          type="search" 
          placeholder="Пошук товарів..." 
          class="w-full bg-neutral-100 text-sm rounded-full py-2 pl-4 pr-9 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 transition border border-transparent focus:bg-white"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <a href="/profile" class="p-2 text-neutral-600 hover:text-neutral-900 rounded-full hover:bg-neutral-100 transition" title="Кабінет">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </a>

      <a href="/cart" class="relative p-2 text-neutral-600 hover:text-neutral-900 rounded-full hover:bg-neutral-100 transition" title="Кошик">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span class="absolute top-1 right-1 bg-indigo-600 text-white text-[10px] font-bold rounded-full h-4 w-4 flex items-center justify-center">
          0
        </span>
      </a>
    </div>

  </div>
</header>